<Project>
    <ItemGroup>
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <PackageReference Include="Scriban" Pack="false" IncludeAssets="build" />
        <Using Remove="System.Diagnostics.CodeAnalysis.NotNullAttribute" />
        <Compile
            Include="$(MSBuildThisFileDirectory)..\Rocket.Surgery.AssemblyInfo\**\*.cs"
            Exclude="$(MSBuildThisFileDirectory)..\Rocket.Surgery.AssemblyInfo\obj\**;$(MSBuildThisFileDirectory)..\Rocket.Surgery.AssemblyInfo\bin\**"
        />
        <!-- Templates are looked up by file-name suffix (see EmbeddedResource.cs), so the logical name only needs to end in the file name. -->
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Rocket.Surgery.AssemblyInfo\*.sbntxt" LogicalName="Rocket.Surgery.AssemblyInfo.%(Filename)%(Extension)" />
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
    <!-- Release tracking: the diagnostics live in Rocket.Surgery.AssemblyInfo's sources, so these builds track them with its files. -->
    <ItemGroup>
        <AdditionalFiles Remove="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\Rocket.Surgery.AssemblyInfo\AnalyzerReleases.Shipped.md;$(MSBuildThisFileDirectory)..\Rocket.Surgery.AssemblyInfo\AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
</Project>
