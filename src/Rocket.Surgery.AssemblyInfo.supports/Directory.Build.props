<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <!--
        Each project here builds the same generator sources as Rocket.Surgery.AssemblyInfo against an older
        Roslyn; that project packs their output into analyzers/dotnet/roslynX.Y/cs.
    -->
    <PropertyGroup>
        <_Analyzer_Roslyn_Version_>$(MSBuildProjectName.Replace('Rocket.Surgery.AssemblyInfo.', ''))</_Analyzer_Roslyn_Version_>
        <DefineConstants>$(DefineConstants);$(_Analyzer_Roslyn_Version_.Replace('.', '_').ToUpper());SCRIBAN_NO_ASYNC</DefineConstants>
        <BaseOutputPath>bin/$(_Analyzer_Roslyn_Version_)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(_Analyzer_Roslyn_Version_)/</BaseIntermediateOutputPath>
        <NoWarn>NU5105;$(NoWarn)</NoWarn>
        <RootNamespace>Rocket.Surgery.AssemblyInfo</RootNamespace>
        <AssemblyName>Rocket.Surgery.AssemblyInfo</AssemblyName>
        <IsPackable>false</IsPackable>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <PackageScribanIncludeSource>true</PackageScribanIncludeSource>
    </PropertyGroup>
</Project>
