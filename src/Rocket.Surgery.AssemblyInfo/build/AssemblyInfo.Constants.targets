<Project>
    <ItemGroup>
        <CompilerVisibleItemMetadata Include="Constant" MetadataName="ItemType" />
        <CompilerVisibleItemMetadata Include="Constant" MetadataName="Comment" />
        <CompilerVisibleItemMetadata Include="Constant" MetadataName="Value" />
        <CompilerVisibleItemMetadata Include="Constant" MetadataName="Type" />
        <CompilerVisibleItemMetadata Include="Constant" MetadataName="Root" />
        <CompilerVisibleItemMetadata Include="Constant" MetadataName="RootComment" />
    </ItemGroup>

    <!--
        PrepareConstants batches on these without qualifying them. An item definition applies to every FileConstant of
        the project, wherever and however it is added, so this is what keeps items an extender adds from failing the
        build with MSB4096. Do not remove one of these while a target here still reads it.
    -->
    <ItemDefinitionGroup>
        <FileConstant>
            <Link />
            <AreaPath />
            <Area />
            <Value />
            <FileExtension />
        </FileConstant>
    </ItemDefinitionGroup>

    <!--
        Prepares the text of @(Constant) items for the editorconfig file the compiler reads them from, where a
        value is a single line. Both Value and Comment are escaped with the backtick as the escape character:

            a backtick                 becomes  two backticks
            a newline (CRLF, LF, CR, and the Unicode line breaks U+0085, U+2028, U+2029)
                                       becomes  a backtick and n

        ConstantsGenerator reads them back left to right (ConstantText.Unescape), so a newline and a literal
        backtick followed by n stay apart. It is not a backslash because that would also match the \n in values
        such as C:\new. The task also stores the text as MSBuild's own escaped form (SetMetadataValueLiteral), which
        makes every later use of the metadata inside a property function safe whatever characters it holds.

        It is an inline task (compiled once and cached by MSBuild) because a property function cannot take the value
        as an argument safely. $(MSBuildToolsPath) holds Microsoft.Build.Tasks.Core.dll in the dotnet CLI's MSBuild
        and in Visual Studio's. Careful editing the code: MSBuild expands properties, items and escapes in it
        first, so it must not contain a dollar sign followed by a parenthesis, an at sign followed by a parenthesis,
        or a percent sign.
    -->
    <UsingTask
        TaskName="RocketSurgeryEncodeConstants"
        TaskFactory="RoslynCodeTaskFactory"
        AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
    >
        <Task>
            <Code Type="Class" Language="cs"><![CDATA[
using System.Collections.Generic;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class RocketSurgeryEncodeConstants : Task
{
    public ITaskItem[] Constants { get; set; }

    [Output]
    public ITaskItem[] EncodedConstants { get; set; }

    public override bool Execute()
    {
        var encoded = new List<ITaskItem>();
        foreach (var constant in Constants ?? new ITaskItem[0])
        {
            // The copy keeps the item spec and the rest of the metadata (Type, Root, RootComment, ...).
            var item = new TaskItem(constant);
            foreach (var name in new[] { "Value", "Comment" })
            {
                // GetMetadata gives the text as written; the literal setter stores it escaped for MSBuild.
                ((ITaskItem2)item).SetMetadataValueLiteral(name, Escape(constant.GetMetadata(name)));
            }

            encoded.Add(item);
        }

        EncodedConstants = encoded.ToArray();
        return true;
    }

    private static string Escape(string text)
    {
        var result = new StringBuilder(text.Length);
        for (var i = 0; i < text.Length; i++)
        {
            var c = text[i];
            if (c == '`')
            {
                result.Append("``");
            }
            else if (c == '\r')
            {
                // CRLF is one newline.
                if (i + 1 < text.Length && text[i + 1] == '\n')
                {
                    i++;
                }

                result.Append("`n");
            }
            else if (c == '\n' || c == (char)0x85 || c == (char)0x2028 || c == (char)0x2029)
            {
                // The compiler splits the editorconfig file at these too, so they cannot stay in a value.
                result.Append("`n");
            }
            else
            {
                result.Append(c);
            }
        }

        return result.ToString();
    }
}
]]></Code>
        </Task>
    </UsingTask>

    <!-- Allows extenders to run before this target to add their @(Constant) and @(FileConstant) items -->
    <Target Name="PrepareConstants">
        <ItemGroup>
            <!-- Remove any FileConstant items that are in intermediate or output directories (e.g. obj/ bin/).
           On macOS the SDK's DefaultItemExcludes uses backslash globs that don't exclude these paths. -->
            <FileConstant
                Remove="@(FileConstant)"
                Condition="$([System.String]::new('%(RelativeDir)').StartsWith('obj')) OR $([System.String]::new('%(RelativeDir)').StartsWith('bin'))"
            />
        </ItemGroup>
        <ItemGroup>
            <FileConstant Condition="!$([System.IO.Path]::IsPathRooted('%(RelativeDir)')) OR '%(Link)' != ''">
                <AreaPath Condition="!$([System.IO.Path]::IsPathRooted('%(RelativeDir)'))">%(RelativeDir)%(Filename)</AreaPath>
                <AreaPath Condition="'%(Link)' != ''">$([System.IO.Path]::GetDirectoryName('%(Link)'))$([System.IO.Path]::DirectorySeparatorChar)$([System.IO.Path]::GetFileNameWithoutExtension('%(Link)'))</AreaPath>
                <FileExtension Condition="!$([System.IO.Path]::IsPathRooted('%(RelativeDir)'))">%(Extension)</FileExtension>
                <FileExtension Condition="'%(Link)' != ''">$([System.IO.Path]::GetExtension('%(Link)'))</FileExtension>
            </FileConstant>
            <FileConstant Condition="'%(AreaPath)' != ''">
                <Area>$([MSBuild]::ValueOrDefault('%(AreaPath)', '').Replace('\', '.').Replace('/', '.'))</Area>
                <Value>%(AreaPath)%(FileExtension)</Value>
            </FileConstant>
            <Constant
                Include="@(FileConstant -> '%(Area)')"
                Condition="'%(FileConstant.Area)' != '' AND '%(FileConstant.Value)' != ''"
                Value="%(FileConstant.Value)"
                Comment="%(FileConstant.Comment)"
            />
        </ItemGroup>
        <!--
            Escape every Value and Comment (see the task above). This cannot be a property function over
            '%(Constant.Value)': MSBuild pastes the metadata into the function's quoted argument as text, so a value
            containing an apostrophe ends the quote early and the build fails with MSB4100.
        -->
        <RocketSurgeryEncodeConstants Constants="@(Constant)" Condition="'@(Constant)' != ''">
            <Output TaskParameter="EncodedConstants" ItemName="_AssemblyInfoEncodedConstant" />
        </RocketSurgeryEncodeConstants>
        <ItemGroup>
            <Constant Remove="@(Constant)" />
            <Constant Include="@(_AssemblyInfoEncodedConstant)" />
            <_AssemblyInfoEncodedConstant Remove="@(_AssemblyInfoEncodedConstant)" />
        </ItemGroup>
    </Target>

    <Target
        Name="_InjectConstantAdditionalFiles"
        BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun"
        DependsOnTargets="PrepareResourceNames;PrepareConstants"
    >
        <ItemGroup>
            <!-- Wrap with |...| when value contains ; (editorconfig separator) or has leading/trailing
           whitespace (editorconfig parser strips it). The generator unwraps |...| and restores ; from |. -->
            <Constant
                Update="@(Constant)"
                Condition="$([MSBuild]::ValueOrdefault('%(Constant.Value)', '').Contains(';'))
                   OR $([MSBuild]::ValueOrdefault('%(Constant.Value)', '').StartsWith(' '))
                   OR $([MSBuild]::ValueOrdefault('%(Constant.Value)', '').EndsWith(' '))"
            >
                <Value>|$([MSBuild]::ValueOrdefault('%(Constant.Value)', '').Replace(';', '|'))|</Value>
            </Constant>

            <AdditionalFiles Include="@(Constant)" />
        </ItemGroup>
    </Target>
</Project>
