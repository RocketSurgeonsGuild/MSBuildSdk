<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <DefineConstants>$(DefineConstants);ROSLYN_CURRENT;SCRIBAN_NO_ASYNC</DefineConstants>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>NU5105;$(NoWarn)</NoWarn>
        <PackageScribanIncludeSource>true</PackageScribanIncludeSource>
        <_AnalyzersLocation>$(MSBuildThisFileDirectory)../Rocket.Surgery.AssemblyInfo.supports/bin/</_AnalyzersLocation>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="*.sbntxt" />
        <EmbeddedResource Include="*.sbntxt" CopyToOutputDirectory="PreserveNewest" />
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
        <PackageReference Include="Polyfill" PrivateAssets="All" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <ProjectReference Include="../Rocket.Surgery.AssemblyInfo.supports/Rocket.Surgery.AssemblyInfo.roslyn5.0.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Rocket.Surgery.AssemblyInfo.supports/Rocket.Surgery.AssemblyInfo.roslyn5.3.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Rocket.Surgery.AssemblyInfo.supports/Rocket.Surgery.AssemblyInfo.roslyn5.6.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
        <PackageReference Include="Scriban" Pack="false" IncludeAssets="build" />
    </ItemGroup>
    <ItemGroup>
        <None Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.0/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.3/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.6/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.6/cs" Visible="false" />
    </ItemGroup>
    <ItemGroup>
        <Using Remove="System.Diagnostics.CodeAnalysis.NotNullAttribute" />
    </ItemGroup>
</Project>
