{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>RocketSurgeonsGuild/.github:renovate-config"],
  "ignorePaths": ["**/node_modules/**", "**/*.csproj"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The .NET SDK pinned in mise (Renovate's mise manager does not update dotnet)",
      "managerFilePatterns": ["/^\\.config/mise\\.toml$/"],
      "matchStrings": ["dotnet = \\[\\s*\\{ version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The extra .NET runtime pinned in mise (Renovate's mise manager ignores the runtime element)",
      "managerFilePatterns": ["/^\\.config/mise\\.toml$/"],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\", runtime = \"dotnet\""],
      "depNameTemplate": "dotnet-runtime",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "The per-Roslyn-version AssemblyInfo builds pin their dependencies on purpose",
      "matchFileNames": ["src/*.AssemblyInfo.supports/**"],
      "enabled": false
    },
    {
      "description": "Keep the global.json and mise.toml .NET SDK pins in lockstep",
      "matchDepNames": ["dotnet-sdk"],
      "groupName": "dotnet sdk"
    },
    {
      "description": "The extra runtime is the net10.0 test runtime; the SDK carries the newest one",
      "matchDepNames": ["dotnet-runtime"],
      "allowedVersions": "<11"
    },
    {
      "description": "net10.0 assets stay on the 10.0.x release train; the net11.0 group moves along 11.0.x",
      "matchPackageNames": ["Microsoft.AspNetCore.*", "Microsoft.Extensions.*"],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "<11.0.0"
    },
    {
      "matchCategories": ["js"],
      "automerge": true,
      "labels": [":truck: private-dependencies"]
    },
    {
      "description": "Shipped: src/Directory.Build.targets writes these into the SDK's common/Packages.props, so a bump changes what every consumer's build pulls in. The org preset marks them private; this repository ships them",
      "matchDepNames": [
        "Rocket.Surgery.Extensions.*",
        "Microsoft.Testing.Extensions.*",
        "Roslynator",
        "Roslynator.*",
        "Microsoft.CodeAnalysis.Analyzers",
        "Microsoft.CodeAnalysis.BannedApiAnalyzers",
        "Microsoft.CodeAnalysis.PublicApiAnalyzers",
        "Microsoft.CodeAnalysis.CSharp",
        "Microsoft.Sbom.Targets",
        "JetBrains.Annotations.Sources",
        "JetBrains.ExternalAnnotations",
        "ZeroAlloc.Analyzers"
      ],
      "labels": [":package: dependencies"]
    },
    {
      "description": "Only the tests (System.Interactive) and the AssemblyInfo generator at compile time (Scriban, PrivateAssets=all) use these: consumers of this repository's packages never get them",
      "matchDepNames": ["System.Interactive", "System.Interactive.*", "Scriban"],
      "labels": [":truck: private-dependencies"]
    }
  ]
}
