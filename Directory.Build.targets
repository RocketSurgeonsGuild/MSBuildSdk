<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <!-- Runtime async: net11.0+ only (the flag breaks net10.0 builds) and never for browser targets (incompatible with WebAssembly). Opt out per project with UseRuntimeAsync=false. -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0')) and '$(TargetPlatformIdentifier)' != 'browser'">
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations.Sources" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <EditorConfigFiles Include="$(MSBuildThisFileDirectory)src/common/editorconfig/CodeAnalysis.editorconfig" />
        <EditorConfigFiles Include="$(MSBuildThisFileDirectory)src/common/editorconfig/CodingStyle.editorconfig" />
        <EditorConfigFiles Include="$(MSBuildThisFileDirectory)src/common/editorconfig/JetBrains.editorconfig" />
        <EditorConfigFiles Include="$(MSBuildThisFileDirectory)src/common/editorconfig/Roslynator.editorconfig" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/common/BannedSymbols.txt" Visible="false" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/common/BannedSymbols.NewtonsoftJson.txt" Visible="false" />
    </ItemGroup>
    <Import Project="$(MSBuildThisFileDirectory)src/common/ContinuousIntegration.targets" />
    <Import Project="$(MSBuildThisFileDirectory)src/common/GitVersion.targets" />
</Project>
